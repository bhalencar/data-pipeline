.claude/

data/

# Arquivos temporários do Excel
~$*

# Logs de execução
orchestration/*.log
docker/logs/

# Página do console do BigQuery salva pelo navegador. Um "Salvar como" do
# console traz o HTML mais uma pasta _files com dezenas de MB de JS e CSS do
# Google -- os "Query 1.1" de 05/09 somavam 43 MB. Isso NAO pode entrar no
# repositório: o git guarda todo blob no histórico para sempre, mesmo depois
# de o arquivo ser apagado. A pasta consultas/ é para SQL, não para páginas.
consultas/*.html
consultas/*_files/
